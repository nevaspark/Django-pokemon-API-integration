# Django Card Service Configuration
DEBUG=1
SECRET_KEY=dev-secret-key-change-in-production-please-use-strong-random-key
ALLOWED_HOSTS=*
PAGE_SIZE=24
CACHE_TTL=3600
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Kong Database Configuration
KONG_DATABASE_USER=kong
KONG_DATABASE_PASSWORD=kong
KONG_DATABASE_NAME=kong

# Kong Configuration
KONG_PROXY_URL=http://localhost:8000
KONG_ADMIN_URL=http://localhost:8001
KONG_ADMIN_GUI_URL=http://localhost:8002

# Card Service Internal URL (for Kong routing)
CARD_SERVICE_URL=http://card-service:8000
